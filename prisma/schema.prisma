// /prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvolvementType {
  KEYNOTE_SPEAKER
  PANELIST
  OBSERVER
  SPONSOR
}

enum AdminRole {
  SUPER_ADMIN
  EVENT_TEAM
}

model Participant {
  id              String             @id @default(uuid())
  participantCode String             @unique
  fullName        String
  email           String             @unique
  mobile          String
  linkedinUrl     String?
  designation     String
  company         String
  industry        String
  companySize     String
  city            String
  involvementType InvolvementType
  consent         Boolean            @default(false)
  status          RegistrationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("participants")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EVENT_TEAM)
  createdAt    DateTime  @default(now())

  @@map("admin_users")
}